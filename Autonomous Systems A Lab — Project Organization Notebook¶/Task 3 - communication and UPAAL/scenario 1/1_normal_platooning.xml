			<nail x="-229" y="-34"/>
			<nail x="-263" y="-34"/>
			<nail x="-263" y="-136"/>
		</transition>
	</template>
	<system>leader = LeaderTruck();
lane = LaneDetection();
controller = SpeedController();
system leader, lane, controller;</system>
	<queries>
		<query>
			<formula>A[] not deadlock</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-07-08 11:58:35 +0200">
			</result>
		</query>
		<query>
			<formula>A[] lane.Processing imply lane.t &lt;= 33</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-07-08 11:58:39 +0200">
			</result>
		</query>
		<query>
			<formula>A[] controller.ReduceSpeed imply dist &lt; 5</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-07-08 11:58:42 +0200">
			</result>
		</query>
		<query>
			<formula>A[] controller.MatchLeaderSpeed imply dist &gt;= 5</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-07-08 11:58:44 +0200">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; controller.MatchLeaderSpeed</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-07-08 11:58:45 +0200">
			</result>
		</query>
	</queries>
</nta>

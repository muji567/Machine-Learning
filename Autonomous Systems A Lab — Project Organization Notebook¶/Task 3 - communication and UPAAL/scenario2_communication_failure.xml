<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>
// Broadcast signal: leader's speed+position beacon may or may not be received
// (it stops being received when the link drops).
broadcast chan signal;       // periodic speed+position from leader
broadcast chan link_restored; // leader's beacon comes back
</declaration>
	<template>
		<name>LeaderTruck</name>
		<declaration>clock t;</declaration>
		<location id="id0" x="-200" y="0">
			<name x="-260" y="-10">Broadcasting</name>
			<label kind="invariant" x="-260" y="20">t &lt;= 100</label>
		</location>
		<location id="id1" x="250" y="0">
			<name x="220" y="-34">LinkDropped</name>
		</location>
		<init ref="id0"/>
		<transition id="id2">
			<source ref="id0"/>
			<target ref="id0"/>
			<label kind="guard" x="-180" y="-120">t &lt;= 100</label>
			<label kind="synchronisation" x="-180" y="-100">signal!</label>
			<label kind="assignment" x="-180" y="-80">t = 0</label>
			<nail x="-200" y="-130"/>
		</transition>
		<transition id="id3">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="comments" x="-50" y="-30">wireless link drops</label>
		</transition>
		<transition id="id4">
			<source ref="id1"/>
			<target ref="id0"/>
			<label kind="synchronisation" x="-50" y="60">link_restored!</label>
			<label kind="assignment" x="-50" y="80">t = 0</label>
			<nail x="250" y="120"/>
			<nail x="-200" y="120"/>
		</transition>
	</template>
	<template>
		<name>FollowerTruck</name>
		<declaration>
clock x;   // timeout timer: time since last received signal
clock f;   // fallback timer: time since failure detected
</declaration>
		<location id="id5" x="-450" y="0">
			<name x="-490" y="-40">Platooning</name>
			<label kind="invariant" x="-490" y="20">x &lt;= 500</label>
		</location>
		<location id="id6" x="-100" y="0">
			<name x="-140" y="-40">FailureDetected</name>
			<label kind="invariant" x="-140" y="20">f &lt;= 100</label>
		</location>
		<location id="id7" x="250" y="0">
			<name x="220" y="-40">FallbackMode</name>
			<label kind="invariant" x="220" y="20">f &lt;= 10000</label>
		</location>
		<location id="id8" x="600" y="0">
			<name x="570" y="-34">SafeStop</name>
		</location>
		<init ref="id5"/>
		<transition id="id9">
			<source ref="id5"/>
			<target ref="id5"/>
			<label kind="synchronisation" x="-560" y="-130">signal?</label>
			<label kind="assignment" x="-560" y="-110">x = 0</label>
			<nail x="-450" y="-130"/>
		</transition>
		<transition id="id10">
			<source ref="id5"/>
			<target ref="id6"/>
			<label kind="guard" x="-420" y="-34">x &gt;= 500</label>
			<label kind="assignment" x="-420" y="20">f = 0</label>
		</transition>
		<transition id="id11">
			<source ref="id6"/>
			<target ref="id7"/>
			<label kind="guard" x="-60" y="-34">f &lt;= 100</label>
		</transition>
		<transition id="id12">
			<source ref="id7"/>
			<target ref="id5"/>
			<label kind="synchronisation" x="0" y="180">link_restored?</label>
			<label kind="assignment" x="0" y="200">x = 0</label>
			<nail x="250" y="220"/>
			<nail x="-450" y="220"/>
		</transition>
		<transition id="id13">
			<source ref="id7"/>
			<target ref="id8"/>
			<label kind="guard" x="320" y="-34">f &gt;= 10000</label>
		</transition>
	</template>
	<template>
		<name>CameraMonitor</name>
		<declaration>clock t;</declaration>
		<location id="id14" x="-200" y="0">
			<name x="-240" y="-34">Idle</name>
		</location>
		<location id="id15" x="150" y="0">
			<name x="120" y="-50">Processing</name>
			<label kind="invariant" x="120" y="20">t &lt;= 33</label>
		</location>
		<init ref="id14"/>
		<transition id="id16">
			<source ref="id14"/>
			<target ref="id15"/>
			<label kind="assignment" x="-150" y="-30">t = 0</label>
		</transition>
		<transition id="id17">
			<source ref="id15"/>
			<target ref="id14"/>
			<label kind="guard" x="-30" y="60">t &lt;= 33</label>
			<nail x="150" y="120"/>
			<nail x="-200" y="120"/>
		</transition>
	</template>
	<system>
leader = LeaderTruck();
follower = FollowerTruck();
camera = CameraMonitor();

system leader, follower, camera;
  </system>
	<queries>
		<query>
			<formula>A[] not deadlock</formula>
			<comment>The system must never get permanently stuck (deadlock-free)</comment>
			<result outcome="success" type="quality" timestamp="2026-06-11 23:16:06 +0200">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; follower.FallbackMode</formula>
			<comment>Fallback mode is reachable when the link drops</comment>
			<result outcome="success" type="quality" timestamp="2026-06-11 23:16:09 +0200">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; follower.SafeStop</formula>
			<comment>SR4: the follower can reach a complete stop</comment>
			<result outcome="success" type="quality" timestamp="2026-06-11 23:16:11 +0200">
			</result>
		</query>
		<query>
			<formula>A[] follower.FailureDetected imply follower.f &lt;= 100</formula>
			<comment>TR2: switch to fallback happens within 100ms of detecting failure</comment>
			<result outcome="success" type="quality" timestamp="2026-06-11 23:16:13 +0200">
			</result>
		</query>
		<query>
			<formula>A[] follower.Platooning imply follower.x &lt;= 500</formula>
			<comment>TR1: failure is always detected within 500ms of the last signal</comment>
			<result outcome="success" type="quality" timestamp="2026-06-11 23:16:15 +0200">
			</result>
		</query>
	</queries>
</nta>
